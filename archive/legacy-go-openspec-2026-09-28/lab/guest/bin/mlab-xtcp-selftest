#!/usr/bin/env bash
set -euo pipefail

if [[ "${EUID:-0}" -ne 0 ]]; then
  exec sudo -E "$0" "$@"
fi

script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
runner="${script_dir}/mlab-xtcp-run"
guest_root="$(cd -- "${script_dir}/.." && pwd)"
expect_dir="${guest_root}/cases/expect"

[[ -x "${runner}" ]] || { echo "error: missing runner: ${runner}" >&2; exit 1; }

pass=0
fail=0

# Minimal regression matrix for P1:
# - core-01: data plane kcp/quic must succeed
# - core-02: include NAT2 (ADF) coverage
# - core-03: easy-like non-baseline must succeed (keep representative coverage)
# - core-06: includes NAT4, both data plane kcp/quic must succeed
# - core-10: hardest; may fail, but must produce stage-level diagnostics
# - explicit failure: signkey mismatch, must fail in signaling stage
runs=(
  "core-01 tcp quic bbr success"
  "core-01 tcp quic brutal success"
  "core-01 tcp kcp bbr success"
  "core-01 quic quic bbr success"
  "core-01 kcp kcp bbr success"

  "core-02 tcp quic bbr success"
  "core-02 tcp kcp bbr success"

  "core-03 tcp quic bbr success"

  "core-06 tcp quic bbr success"
  "core-06 tcp kcp bbr success"

  "core-01-loss tcp quic brutal success"
  "core-01-loss tcp kcp bbr success"

  "core-10 tcp quic bbr diag-fail"

  "core-01 tcp quic bbr fail exchange signkey-mismatch"
)

for r in "${runs[@]}"; do
  read -r case_id control_proto data_proto quic_cc expect extra_stage extra_tag <<<"${r}"

  echo "== ${case_id} control=${control_proto} data=${data_proto} quic_cc=${quic_cc} expect=${expect} =="

  args=("${case_id}" "--control-proto" "${control_proto}" "--data-proto" "${data_proto}" "--quic-cc" "${quic_cc}" "--expect" "${expect}" "--disable-portmap" "--verify-artifacts")

  if [[ "${expect}" == "success" ]]; then
    if [[ "${data_proto}" == "quic" ]]; then
      expect_events_file="${expect_dir}/transport-quic.${quic_cc}.events.json"
    else
      expect_events_file="${expect_dir}/transport-kcp.events.json"
    fi
    if [[ "${case_id}" == "core-01-loss" ]]; then
      if [[ "${data_proto}" == "quic" ]]; then
        expect_events_file="${expect_dir}/core-01-loss.quic.${quic_cc}.events.json"
      else
        expect_events_file="${expect_dir}/core-01-loss.kcp.events.json"
      fi
    fi
    args+=("--expect-events-file" "${expect_events_file}")
  fi

  if [[ "${expect}" == "fail" ]]; then
    args+=("--expect-fail-stage" "${extra_stage}")
    if [[ "${extra_tag}" == "signkey-mismatch" ]]; then
      args+=("--visitor-secret" "wrong-secret")
    fi
  fi

  if "${runner}" "${args[@]}"; then
    pass=$((pass + 1))
  else
    fail=$((fail + 1))
  fi
done

echo "summary: pass=${pass} fail=${fail}"
if [[ "${fail}" -ne 0 ]]; then
  exit 1
fi
