    "${vm_name}:/opt/miopunch-lab/bin/"
  echo "ok: pushed miopunch binaries to /opt/miopunch-lab/bin/{miopunch,miopunch-poc-e2e}"
}

cmd_pull_artifacts() {
  require_cmd rsync
  local src="/opt/miopunch-lab/artifacts/"
  local dst="${lab_dir}/_artifacts/"
  mkdir -p "${dst}"
  rsync -az -e "ssh -F ${ssh_config}" "${vm_name}:${src}" "${dst}"
  echo "ok: pulled artifacts into ${dst}"
}

cmd_selftest() {
  cmd_up
  cmd_wait
  cmd_wait_guest
  cmd_push_guest
  set +e
  cmd_guest sudo /opt/miopunch-lab/guest/bin/mlab-selftest
  local rc=$?
  set -e
  cmd_pull_artifacts
  return "${rc}"
}

