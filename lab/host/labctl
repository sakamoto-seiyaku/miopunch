cmd_poc_v1_cli_smoke() {
  require_cmd rsync
  local go
  go="$(find_go)" || die "missing dependency: go (or /usr/local/go/bin/go)"
  local broker_url
  broker_url="$(resolve_poc_v1_cli_smoke_broker_url)"

  local out_dir="${state_dir}/bin"
  local product_bin="${out_dir}/miopunch"
  mkdir -p "${out_dir}"

  echo "building: ${product_bin}"
  (cd "${repo_root}" && "${go}" build -o "${product_bin}" ./cmd/miopunch)

  cmd_up
  cmd_wait
  cmd_wait_guest
  cmd_guest sudo mkdir -p /opt/miopunch-lab/bin
  cmd_guest sudo chown -R "${vm_user}:${vm_user}" /opt/miopunch-lab/bin
  rsync -az -e "ssh -F ${ssh_config}" "${product_bin}" "${vm_name}:/opt/miopunch-lab/bin/"
  echo "ok: pushed miopunch binary to /opt/miopunch-lab/bin/miopunch"

  cmd_push_guest
  cmd_guest sudo chmod 0755 /opt/miopunch-lab/guest/bin/mlab-poc-v1-cli-smoke
  set +e
  cmd_guest sudo env \
    "MIOPUNCH_POC_V1_CLI_SMOKE_BROKER_URL=${broker_url}" \
    /opt/miopunch-lab/guest/bin/mlab-poc-v1-cli-smoke
  local rc=$?
  set -e
  cmd_pull_artifacts
  return "${rc}"
}

