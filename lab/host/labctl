cmd_down() {
  if ! is_running; then
    echo "ok: not running"
    return 0
  fi

  local pid
  pid="$(cat "${pid_file}")"
  echo "stopping (pid ${pid})..."

  # Try graceful shutdown first (cloud images usually have sudo).
  cmd_ssh -o ConnectTimeout=2 sudo poweroff >/dev/null 2>&1 || true

  local i
  for i in {1..30}; do
    if ! kill -0 "${pid}" 2>/dev/null; then
      rm -f "${pid_file}"
      echo "ok: stopped"
      return 0
    fi
    sleep 1
  done

  echo "warn: graceful shutdown timed out; killing qemu"
  kill "${pid}" 2>/dev/null || true
  sleep 1
  kill -9 "${pid}" 2>/dev/null || true
  rm -f "${pid_file}"
  echo "ok: killed"
}

cmd_status() {
  if is_running; then
    echo "running: pid $(cat "${pid_file}")"
    echo "ssh    : ssh -F ${ssh_config} ${vm_name}"
  else
    echo "stopped"
  fi
}

require_vm_stopped() {
  if is_running; then
    die "vm is running; stop it first: lab/host/labctl down"
  fi
}

cmd_snapshot_list() {
  require_cmd qemu-img
  [[ -f "${disk_file}" ]] || die "missing disk: ${disk_file}"
  qemu-img snapshot -l "${disk_file}"
}

cmd_snapshot_create() {
  require_cmd qemu-img
  [[ $# -eq 1 ]] || die "snapshot-create: need <name>"
  require_vm_stopped
  qemu-img snapshot -c "$1" "${disk_file}"
  echo "ok: snapshot created: $1"
}

cmd_snapshot_restore() {
  require_cmd qemu-img
  [[ $# -eq 1 ]] || die "snapshot-restore: need <name>"
  require_vm_stopped
  qemu-img snapshot -a "$1" "${disk_file}"
  echo "ok: snapshot restored: $1"
}

main() {
  local cmd="${1:-}"
  shift || true

  case "${cmd}" in
    -h|--help|help|"")
      usage
      ;;
    download) cmd_download "$@" ;;
    init) cmd_init "$@" ;;
    up) cmd_up "$@" ;;
    wait) cmd_wait "$@" ;;
    wait-guest) cmd_wait_guest "$@" ;;
    ssh) cmd_ssh "$@" ;;
    guest) cmd_guest "$@" ;;
    push-guest) cmd_push_guest "$@" ;;
    push-bin) cmd_push_bin "$@" ;;
    pull-artifacts) cmd_pull_artifacts "$@" ;;
    selftest) cmd_selftest "$@" ;;
    xtcp-selftest) cmd_xtcp_selftest "$@" ;;
    xtcp-connectivity-selftest) cmd_xtcp_connectivity_selftest "$@" ;;
