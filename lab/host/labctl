#!/usr/bin/env bash
set -euo pipefail

script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
repo_root="$(cd -- "${script_dir}/../.." && pwd)"

lab_dir="${repo_root}/lab"
images_dir="${lab_dir}/_images"
state_dir="${lab_dir}/_state"

vm_name="${LAB_VM_NAME:-miopunch-lab}"
vm_user="${LAB_VM_USER:-lab}"
ssh_port="${LAB_SSH_PORT:-2222}"
mem_mb="${LAB_MEM_MB:-4096}"
cpus="${LAB_CPUS:-2}"
disk_size="${LAB_DISK_SIZE:-20G}"

image_url="${LAB_IMAGE_URL:-https://cloud.debian.org/images/cloud/bookworm/latest/debian-12-genericcloud-amd64.qcow2}"
image_file="${LAB_IMAGE_FILE:-${images_dir}/debian-12-genericcloud-amd64.qcow2}"
image_sha256="${LAB_IMAGE_SHA256:-}"

disk_file="${state_dir}/disk.qcow2"
seed_file="${state_dir}/seed.img"
pid_file="${state_dir}/qemu.pid"
log_file="${state_dir}/qemu.log"
serial_log="${state_dir}/serial.log"

ssh_key="${state_dir}/ssh_key"
ssh_key_pub="${state_dir}/ssh_key.pub"
ssh_config="${state_dir}/ssh_config"
known_hosts="${state_dir}/known_hosts"

cloud_init_dir="${state_dir}/cloud-init"
user_data="${cloud_init_dir}/user-data"
meta_data="${cloud_init_dir}/meta-data"

die() {
  echo "error: $*" >&2
  exit 1
}

usage() {
  cat <<'EOF'
Usage: lab/host/labctl <command> [args...]

Commands:
  download                 Download Debian cloud image (qcow2)
  init                     Create SSH key, cloud-init seed, qcow2 overlay
  up                       Start the single QEMU VM (SSH forwarded to 127.0.0.1:$LAB_SSH_PORT)
  wait                     Wait for SSH to become ready
  wait-guest               Wait for cloud-init to finish inside the VM
  ssh [ssh-args...]        SSH into the VM
  guest <cmd...>           Run a command inside the VM via SSH
  push-guest               Rsync lab/guest/ into /opt/miopunch-lab/guest in the VM
  push-bin                 Build miopunch binaries on host and rsync into /opt/miopunch-lab/bin in the VM
  pull-artifacts           Rsync /opt/miopunch-lab/artifacts/ from the VM into lab/_artifacts/
  selftest                 Run guest selftest and pull artifacts
  xtcp-selftest            Run guest xtcp selftest and pull artifacts
  xtcp-connectivity-selftest  Run guest xtcp connectivity selftest and pull artifacts
  xtcp-fulltest            Run guest xtcp full-case test and pull artifacts
  mnt01-smoke              Run guest MNT-01 smoke gate and pull artifacts
  mnt01-selftest           Run guest MNT-01 selftest gate and pull artifacts
  mnt01-fulltest           Run guest MNT-01 full matrix gate and pull artifacts
  mnt02-smoke              Run guest MNT-02 smoke gate and pull artifacts
  mnt02-selftest           Run guest MNT-02 selftest gate and pull artifacts
  mnt03-smoke              Run guest MNT-03 smoke gate and pull artifacts
  mnt03-selftest           Run guest MNT-03 selftest gate and pull artifacts
  mnt03-fulltest           Run guest MNT-03 full gate and pull artifacts
  poc-v1-cli-smoke         Run guest POC v1 CLI remote-broker smoke and pull artifacts
  poc-e2e-smoke            Run guest POC e2e smoke and pull artifacts
  poc-e2e-selftest         Run guest POC e2e selftest and pull artifacts
  poc-e2e-fulltest         Run guest POC e2e fulltest and pull artifacts
  down                     Stop the VM (graceful poweroff, then kill if needed)
  status                   Show VM status

  snapshot-list            List qcow2 internal snapshots
  snapshot-create <name>   Create snapshot (VM must be stopped)
  snapshot-restore <name>  Restore snapshot (VM must be stopped)

Environment overrides:
  LAB_VM_NAME, LAB_VM_USER, LAB_SSH_PORT, LAB_MEM_MB, LAB_CPUS, LAB_DISK_SIZE
  LAB_IMAGE_URL, LAB_IMAGE_FILE, LAB_IMAGE_SHA256
EOF
}

require_cmd() {
  command -v "$1" >/dev/null 2>&1 || die "missing dependency: $1"
}

find_go() {
  if command -v go >/dev/null 2>&1; then
    command -v go
    return 0
  fi
  if [[ -x /usr/local/go/bin/go ]]; then
    echo "/usr/local/go/bin/go"
    return 0
  fi
  return 1
}

resolve_poc_v1_cli_smoke_broker_url() {
  local value="${MIOPUNCH_POC_V1_CLI_SMOKE_BROKER_URL:-${MIOPUNCH_REMOTE_MQTT_BROKER_URL:-}}"

  value="${value#"${value%%[![:space:]]*}"}"
  value="${value%"${value##*[![:space:]]}"}"
  [[ -n "${value}" ]] || die "missing broker env: set MIOPUNCH_POC_V1_CLI_SMOKE_BROKER_URL or MIOPUNCH_REMOTE_MQTT_BROKER_URL"

  if [[ "${value}" != *"://"* ]]; then
    value="tcp://${value}"
  fi

  case "${value}" in
    tcp://127.0.0.1:*|tcp://localhost:*|127.0.0.1:*|localhost:*)
      die "invalid broker endpoint: ${value} (use a real remote MQTT broker)"
      ;;
  esac

  printf '%s\n' "${value}"
}

ensure_dirs() {
  mkdir -p "${images_dir}" "${state_dir}" "${cloud_init_dir}"
}

is_running() {
  [[ -f "${pid_file}" ]] || return 1
  local pid
  pid="$(cat "${pid_file}" 2>/dev/null || true)"
  [[ -n "${pid}" ]] || return 1
  kill -0 "${pid}" 2>/dev/null
}

write_ssh_config() {
  cat >"${ssh_config}" <<EOF
Host ${vm_name}
  HostName 127.0.0.1
  Port ${ssh_port}
  User ${vm_user}
  IdentityFile ${ssh_key}
  IdentitiesOnly yes
  StrictHostKeyChecking no
  UserKnownHostsFile ${known_hosts}
  LogLevel ERROR
EOF
}

cmd_download() {
  require_cmd curl
  ensure_dirs
  if [[ -f "${image_file}" ]]; then
    echo "ok: image already exists: ${image_file}"
    return 0
  fi

  echo "downloading: ${image_url}"
  local tmp="${image_file}.tmp"
  curl -L --fail --retry 3 --connect-timeout 10 -o "${tmp}" "${image_url}"

  if [[ -n "${image_sha256}" ]]; then
    require_cmd sha256sum
    echo "${image_sha256}  ${tmp}" | sha256sum -c -
  fi

  mv -f "${tmp}" "${image_file}"
  echo "ok: saved: ${image_file}"
}

cmd_init() {
  require_cmd ssh-keygen
  require_cmd cloud-localds
  require_cmd qemu-img

  ensure_dirs
  [[ -f "${image_file}" ]] || die "base image missing; run: lab/host/labctl download"

  if [[ ! -f "${ssh_key}" ]]; then
    ssh-keygen -t ed25519 -N "" -f "${ssh_key}" -C "miopunch-lab"
  fi
  [[ -f "${ssh_key_pub}" ]] || die "missing pubkey: ${ssh_key_pub}"

  local pubkey
  pubkey="$(cat "${ssh_key_pub}")"

  cat >"${meta_data}" <<EOF
instance-id: ${vm_name}
local-hostname: ${vm_name}
EOF

  cat >"${user_data}" <<EOF
#cloud-config
users:
  - name: ${vm_user}
    shell: /bin/bash
    sudo: ALL=(ALL) NOPASSWD:ALL
    ssh_authorized_keys:
      - ${pubkey}

package_update: true
packages:
  - openssh-server
  - iproute2
  - nftables
  - iptables
  - tcpdump
  - conntrack
  - iputils-ping
  - jq
  - curl
  - ca-certificates
  - rsync
  - netcat-openbsd
  - socat
  - tmux
  - docker.io

runcmd:
  - [ systemctl, enable, --now, ssh ]
  - [ systemctl, enable, --now, docker ]
EOF

  cloud-localds "${seed_file}" "${user_data}" "${meta_data}"
  write_ssh_config

  if [[ ! -f "${disk_file}" ]]; then
    qemu-img create -f qcow2 -F qcow2 -b "${image_file}" "${disk_file}" "${disk_size}"
  fi

  echo "ok: init complete"
  echo "  disk: ${disk_file}"
  echo "  seed: ${seed_file}"
  echo "  ssh : ssh -F ${ssh_config} ${vm_name}"
}

cmd_up() {
  require_cmd qemu-system-x86_64
  ensure_dirs

  if is_running; then
    echo "ok: already running (pid $(cat "${pid_file}"))"
    return 0
  fi

  [[ -f "${disk_file}" && -f "${seed_file}" ]] || cmd_init

  rm -f "${pid_file}"
  mkdir -p "$(dirname -- "${log_file}")"
  : >"${log_file}"
  : >"${serial_log}"

  local cpu_model="host"
  if [[ ! -e /dev/kvm ]] || [[ ! -r /dev/kvm ]] || [[ ! -w /dev/kvm ]]; then
    cpu_model="max"
    echo "warn: /dev/kvm not accessible; QEMU may fall back to TCG (slow)"
  fi

  # accel=kvm:tcg will try KVM first and fall back to TCG automatically.
  if ! qemu-system-x86_64 \
    -name "${vm_name}" \
    -machine accel=kvm:tcg \
    -cpu "${cpu_model}" \
    -smp "${cpus}" \
    -m "${mem_mb}" \
    -drive if=virtio,file="${disk_file}",format=qcow2 \
    -drive if=virtio,file="${seed_file}",format=raw \
    -netdev user,id=n0,hostfwd=tcp:127.0.0.1:"${ssh_port}"-:22 \
    -device virtio-net-pci,netdev=n0 \
    -display none \
    -serial "file:${serial_log}" \
    -monitor none \
    -daemonize \
    -pidfile "${pid_file}" \
    -D "${log_file}" \
    2>>"${log_file}"; then
    echo "error: QEMU failed to start (see ${log_file})" >&2
    tail -n 80 "${log_file}" >&2 || true
    if grep -q "host forwarding rule" "${log_file}" 2>/dev/null; then
      echo "hint: SSH port may be in use; try a different port, e.g.: LAB_SSH_PORT=2223 ./lab/host/labctl up" >&2
    fi
    exit 1
  fi

  echo "ok: started (pid $(cat "${pid_file}"))"
  echo "  ssh: ssh -F ${ssh_config} ${vm_name}"
}

cmd_wait() {
  local deadline="${LAB_WAIT_SECONDS:-120}"
  local start now
  start="$(date +%s)"

  echo "waiting for ssh (timeout ${deadline}s)..."
  while true; do
    if cmd_ssh -o BatchMode=yes -o ConnectTimeout=2 true >/dev/null 2>&1; then
      echo "ok: ssh ready"
      return 0
    fi
    now="$(date +%s)"
    if (( now - start > deadline )); then
      die "ssh not ready after ${deadline}s (see ${log_file})"
    fi
    sleep 2
  done
}

cmd_wait_guest() {
  local deadline="${LAB_GUEST_READY_SECONDS:-600}"
  local start now
  start="$(date +%s)"

  echo "waiting for guest cloud-init..."
  while true; do
    if cmd_guest test -f /var/lib/cloud/instance/boot-finished >/dev/null 2>&1; then
      echo "ok: guest ready"
      return 0
    fi
    now="$(date +%s)"
    if (( now - start > deadline )); then
      die "guest not ready after ${deadline}s (cloud-init)"
    fi
    sleep 5
  done
}

cmd_ssh() {
  require_cmd ssh
  [[ -f "${ssh_config}" ]] || write_ssh_config
  ssh -F "${ssh_config}" "${vm_name}" "$@"
}

cmd_guest() {
  [[ $# -ge 1 ]] || die "guest: missing command"
  cmd_ssh -- "$@"
}

ensure_guest_tmux() {
  if cmd_guest command -v tmux >/dev/null 2>&1; then
    return 0
  fi
  echo "info: tmux not found in guest; installing..."
  cmd_guest sudo apt-get update
  cmd_guest sudo apt-get install -y tmux
}

cmd_push_guest() {
  require_cmd rsync
  local src="${lab_dir}/guest/"
  local dst="/opt/miopunch-lab/guest/"

  cmd_guest sudo mkdir -p /opt/miopunch-lab
  cmd_guest sudo chown -R "${vm_user}:${vm_user}" /opt/miopunch-lab

  rsync -az --delete -e "ssh -F ${ssh_config}" "${src}" "${vm_name}:${dst}"
  echo "ok: pushed guest runtime to ${dst}"
}

cmd_push_bin() {
  require_cmd rsync
  local go
  go="$(find_go)" || die "missing dependency: go (or /usr/local/go/bin/go)"

  local out_dir="${state_dir}/bin"
  local product_bin="${out_dir}/miopunch"
  local lab_bin="${out_dir}/miopunch-lab"
  local poc_e2e_bin="${out_dir}/miopunch-poc-e2e"
  mkdir -p "${out_dir}"

  echo "building: ${product_bin}"
  (cd "${repo_root}" && "${go}" build -o "${product_bin}" ./cmd/miopunch)
  echo "building: ${lab_bin}"
  (cd "${repo_root}" && "${go}" build -o "${lab_bin}" ./cmd/miopunch-lab)
  echo "building: ${poc_e2e_bin}"
  (cd "${repo_root}" && "${go}" build -o "${poc_e2e_bin}" ./tools/miopunch-poc-e2e)

  cmd_guest sudo mkdir -p /opt/miopunch-lab/bin
  cmd_guest sudo chown -R "${vm_user}:${vm_user}" /opt/miopunch-lab/bin

  rsync -az -e "ssh -F ${ssh_config}" \
    "${product_bin}" \
    "${lab_bin}" \
    "${poc_e2e_bin}" \
    "${vm_name}:/opt/miopunch-lab/bin/"
  echo "ok: pushed miopunch binaries to /opt/miopunch-lab/bin/{miopunch,miopunch-lab,miopunch-poc-e2e}"
}

