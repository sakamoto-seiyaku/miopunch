#!/usr/bin/env bash
set -euo pipefail

if [[ "${EUID:-0}" -ne 0 ]]; then
  exec sudo -E "$0" "$@"
fi

script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
guest_root="$(cd -- "${script_dir}/.." && pwd)"

# shellcheck source=/dev/null
source "${guest_root}/lib/common.sh"
# shellcheck source=/dev/null
source "${guest_root}/lib/topology.sh"

mlab="${script_dir}/mlab"
miopunch="${MLAB_MIOPUNCH_BIN:-/opt/miopunch-lab/bin/miopunch}"
assert_events="${script_dir}/mlab-xtcp-assert-events"

artifacts_root="${MLAB_ARTIFACTS_ROOT:-/opt/miopunch-lab/artifacts}"

run_dir=""
tcpdump_pid=""
stun_pid=""
coord_pid=""
mqtt_pid=""
client_pid=""
natA_pmp_pid=""
natB_pmp_pid=""
state_dumped=0

usage() {
  cat <<'EOF'
Usage: mlab-xtcp-run <case-id> [flags]

Flags:
  --signaling <coord|mqtt>          Signaling backend (default: coord)
  --mqtt-broker <host:port>         MQTT broker address when --signaling=mqtt (default: <coord-ip>:1883)
  --control-proto <tcp|kcp|quic>    Control plane protocol (default: tcp)
  --data-proto <kcp|quic>           Data plane protocol (default: quic)
  --quic-cc <bbr|brutal>            QUIC congestion control (default: bbr; only when --data-proto=quic)
  --proxy <name>                    Proxy name (default: p1)
  --secret <secret>                 Secret key for client side (default: secret)
  --visitor-secret <secret>         Secret key used by visitor (default: same as --secret)
  --payload <string>                Payload to send (default: ping)
  --attempt-v6-timeout <duration>   Override IPv6 direct attempt timeout for peers
  --disable-stun                    Do not configure STUN for peers
  --disable-portmap                 Disable portmap helpers for peers
  --start-natpmpd                   Start a minimal NAT-PMP server in both NAT namespaces
  --natpmpd-verbose                 Enable natpmpd verbose logging
  --expect <success|fail|diag-fail|allow-diag-fail> Expected outcome (default: success)
  --expect-fail-stage <stage>       If set, require a fail event at this stage (e.g. signaling)
  --expect-events-file <path>       Ordered JSON event expectations for visitor.log
  --expect-path <direct_ipv6|direct_ipv4|punching_ipv4>
                                   If set, require the visitor to succeed via this attempt path
  --verify-artifacts                Require the minimal artifact set before passing

Artifacts:
  Writes a run dir under /opt/miopunch-lab/artifacts/ and stores:
  - coord|mqtt, client, visitor, stun logs (json event stream + errors)
  - wan pcap
  - nat iptables/conntrack/tc snapshots
EOF
}

preflight() {
  need_cmd ip
  need_cmd iptables-save
  need_cmd conntrack
  need_cmd tcpdump
  need_cmd timeout
  need_cmd grep
  [[ -x "${miopunch}" ]] || die "missing miopunch binary: ${miopunch}"
  [[ -x "${mlab}" ]] || die "missing mlab: ${mlab}"
}

ensure_state_dumped() {
  if [[ "${state_dumped}" -eq 0 ]]; then
    dump_state || true
    state_dumped=1
  fi
}

resolve_path() {
  local path="$1"
  if [[ "${path}" = /* ]]; then
    printf '%s\n' "${path}"
    return 0
  fi
  printf '%s\n' "${guest_root}/${path}"
}

verify_run_artifacts() {
  local required=(
    run.env
    visitor.log
    client.log
    wan.pcap
    natA.iptables
    natB.iptables
    natA.conntrack
    natB.conntrack
    natA.tc
    natB.tc
    netns.txt
  )

  local f
  for f in "${required[@]}"; do
    [[ -e "${run_dir}/${f}" ]] || die "missing artifact: ${f} (run_dir=${run_dir})"
  done

  if [[ "${signaling:-coord}" == "coord" ]]; then
    [[ -e "${run_dir}/coord.log" ]] || die "missing artifact: coord.log (run_dir=${run_dir})"
  else
    [[ -e "${run_dir}/mqtt.log" ]] || die "missing artifact: mqtt.log (run_dir=${run_dir})"
  fi

  if [[ "${disable_stun:-0}" -eq 0 ]]; then
    [[ -e "${run_dir}/stun.log" ]] || die "missing artifact: stun.log (run_dir=${run_dir})"
  fi
  if [[ "${start_natpmpd:-0}" -eq 1 ]]; then
    [[ -e "${run_dir}/natA.natpmpd.log" ]] || die "missing artifact: natA.natpmpd.log (run_dir=${run_dir})"
    [[ -e "${run_dir}/natB.natpmpd.log" ]] || die "missing artifact: natB.natpmpd.log (run_dir=${run_dir})"
  fi
}

start_bg_in_netns() {
  local ns="$1"
  local log_file="$2"
  shift 2
  ip netns exec "${ns}" sh -c 'log="$1"; shift; "$@" >"$log" 2>&1 & echo $!' _ "${log_file}" "$@"
}

stop_pid() {
  local pid="$1"
  if [[ -z "${pid}" ]]; then
    return 0
  fi
  if kill -0 "${pid}" 2>/dev/null; then
    kill "${pid}" 2>/dev/null || true
    for _ in {1..50}; do
      if ! kill -0 "${pid}" 2>/dev/null; then
        return 0
      fi
      sleep 0.1
    done
    kill -9 "${pid}" 2>/dev/null || true
  fi
}

stop_pid_int() {
  local pid="$1"
  if [[ -z "${pid}" ]]; then
    return 0
  fi
  if kill -0 "${pid}" 2>/dev/null; then
    kill -INT "${pid}" 2>/dev/null || true
    for _ in {1..40}; do
      if ! kill -0 "${pid}" 2>/dev/null; then
        return 0
      fi
      sleep 0.1
    done
    kill "${pid}" 2>/dev/null || true
    for _ in {1..20}; do
      if ! kill -0 "${pid}" 2>/dev/null; then
        return 0
      fi
      sleep 0.1
    done
    kill -9 "${pid}" 2>/dev/null || true
  fi
}

dump_state() {
  ns_exec "${NS_NAT_A}" iptables-save >"${run_dir}/natA.iptables" 2>&1 || true
  ns_exec "${NS_NAT_B}" iptables-save >"${run_dir}/natB.iptables" 2>&1 || true

  ns_exec "${NS_NAT_A}" conntrack -L >"${run_dir}/natA.conntrack" 2>&1 || true
  ns_exec "${NS_NAT_B}" conntrack -L >"${run_dir}/natB.conntrack" 2>&1 || true

  ns_exec "${NS_NAT_A}" tc -s qdisc show >"${run_dir}/natA.tc" 2>&1 || true
  ns_exec "${NS_NAT_B}" tc -s qdisc show >"${run_dir}/natB.tc" 2>&1 || true

  ip netns list >"${run_dir}/netns.txt" 2>&1 || true
}

main() {
  local case_id="${1:-}"
  shift || true
  [[ -n "${case_id}" ]] || { usage; exit 2; }

  local control_proto="tcp"
  local data_proto="quic"
  local quic_cc="bbr"
  local proxy_name="p1"
  local secret="secret"
  local visitor_secret=""
  local payload="ping"
  local attempt_v6_timeout=""
  local signaling="coord"
  local mqtt_broker=""
  local disable_stun=0
  local disable_portmap=0
  local start_natpmpd=0
  local natpmpd_verbose=0
  local expect="success"
  local expect_fail_stage=""
  local expect_events_file=""
  local expect_path=""
  local verify_artifacts=0

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --signaling) signaling="${2:-}"; shift 2 ;;
      --mqtt-broker) mqtt_broker="${2:-}"; shift 2 ;;
      --control-proto) control_proto="${2:-}"; shift 2 ;;
      --data-proto) data_proto="${2:-}"; shift 2 ;;
      --quic-cc) quic_cc="${2:-}"; shift 2 ;;
      --proxy) proxy_name="${2:-}"; shift 2 ;;
      --secret) secret="${2:-}"; shift 2 ;;
      --visitor-secret) visitor_secret="${2:-}"; shift 2 ;;
      --payload) payload="${2:-}"; shift 2 ;;
      --attempt-v6-timeout) attempt_v6_timeout="${2:-}"; shift 2 ;;
      --disable-stun) disable_stun=1; shift 1 ;;
      --disable-portmap) disable_portmap=1; shift 1 ;;
      --start-natpmpd) start_natpmpd=1; shift 1 ;;
      --natpmpd-verbose) natpmpd_verbose=1; shift 1 ;;
      --expect) expect="${2:-}"; shift 2 ;;
      --expect-fail-stage) expect_fail_stage="${2:-}"; shift 2 ;;
      --expect-events-file) expect_events_file="${2:-}"; shift 2 ;;
      --expect-path) expect_path="${2:-}"; shift 2 ;;
      --verify-artifacts) verify_artifacts=1; shift 1 ;;
      -h|--help|help) usage; exit 0 ;;
      *) die "unknown arg: $1" ;;
    esac
  done
  if [[ -z "${visitor_secret}" ]]; then
    visitor_secret="${secret}"
  fi

  case "${signaling}" in coord|mqtt) ;; *) die "invalid --signaling: ${signaling}" ;; esac
  case "${control_proto}" in tcp|kcp|quic) ;; *) die "invalid --control-proto: ${control_proto}" ;; esac
  case "${data_proto}" in kcp|quic) ;; *) die "invalid --data-proto: ${data_proto}" ;; esac
  if [[ "${data_proto}" == "quic" ]]; then
    case "${quic_cc}" in bbr|brutal) ;; *) die "invalid --quic-cc: ${quic_cc}" ;; esac
  else
    quic_cc="bbr"
  fi
  if [[ "${signaling}" == "mqtt" && -z "${mqtt_broker}" ]]; then
    mqtt_broker="${COORD_IP}:1883"
  fi
  case "${expect}" in success|fail|diag-fail|allow-diag-fail) ;; *) die "invalid --expect: ${expect}" ;; esac
  if [[ -n "${expect_path}" ]]; then
    case "${expect_path}" in direct_ipv6|direct_ipv4|punching_ipv4) ;; *) die "invalid --expect-path: ${expect_path}" ;; esac
  fi
  if [[ -n "${expect_events_file}" ]]; then
    expect_events_file="$(resolve_path "${expect_events_file}")"
    [[ -f "${expect_events_file}" ]] || die "missing --expect-events-file: ${expect_events_file}"
  fi

  local a_p2p_port=5000
  local b_p2p_port=5000
  local case_file="${guest_root}/cases/${case_id}.sh"
  if [[ -f "${case_file}" ]]; then
    # shellcheck source=/dev/null
    source "${case_file}"
    a_p2p_port="${A_P2P_PORT:-5000}"
    b_p2p_port="${B_P2P_PORT:-5000}"
  fi

  preflight
  if [[ -n "${expect_events_file}" ]]; then
    need_cmd python3
    [[ -f "${assert_events}" ]] || die "missing assert helper: ${assert_events}"
  fi

  local natpmpd="${script_dir}/mlab-natpmpd"
  if [[ "${start_natpmpd}" -eq 1 ]]; then
    need_cmd python3
    [[ -x "${natpmpd}" ]] || die "missing natpmpd: ${natpmpd}"
  fi

  local ts
  ts="$(date -u +%Y%m%dT%H%M%SZ)"
  run_dir="${artifacts_root}/${ts}-xtcp-${case_id}-${control_proto}-${data_proto}"
  if [[ "${data_proto}" == "quic" ]]; then
    run_dir="${run_dir}-${quic_cc}"
  fi
  mkdir -p "${run_dir}"
  echo "run_dir=${run_dir}"

  local stun_addrs=""
  if [[ "${disable_stun}" -eq 0 ]]; then
    stun_addrs="${STUN_IP}:3478,${STUN_IP}:3479"
  fi

  {
    echo "ts_utc=${ts}"
    echo "case_id=${case_id}"
    echo "signaling=${signaling}"
    echo "mqtt_broker=${mqtt_broker}"
    echo "control_proto=${control_proto}"
    echo "data_proto=${data_proto}"
    echo "quic_cc=${quic_cc}"
    echo "proxy_name=${proxy_name}"
    echo "stun_addrs=${stun_addrs}"
    echo "coord_addr=${COORD_IP}:7000"
    echo "peerA_ns=${NS_PEER_A}"
    echo "peerB_ns=${NS_PEER_B}"
    echo "peerA_p2p_port=${a_p2p_port}"
    echo "peerB_p2p_port=${b_p2p_port}"
    echo "enable_ipv6=${ENABLE_IPV6:-0}"
    echo "block_forward_udp6=${BLOCK_FORWARD_UDP6:-0}"
    echo "wan_netem=${WAN_NETEM:-}"
    echo "p2p_udp_loss_probability=${P2P_UDP_LOSS_PROBABILITY:-}"
    echo "attempt_v6_timeout=${attempt_v6_timeout}"
    echo "disable_stun=${disable_stun}"
    echo "disable_portmap=${disable_portmap}"
    echo "start_natpmpd=${start_natpmpd}"
    echo "expect_events_file=${expect_events_file}"
    echo "expect_path=${expect_path}"
    echo "verify_artifacts=${verify_artifacts}"
  } >"${run_dir}/run.env"

  state_dumped=0
  tcpdump_pid=""
  stun_pid=""
  coord_pid=""
  mqtt_pid=""
  client_pid=""
  natA_pmp_pid=""
  natB_pmp_pid=""
  finish() {
    local rc=$?
    stop_pid "${client_pid:-}" || true
    stop_pid "${coord_pid:-}" || true
    stop_pid "${mqtt_pid:-}" || true
    stop_pid "${stun_pid:-}" || true
    stop_pid "${natA_pmp_pid:-}" || true
    stop_pid "${natB_pmp_pid:-}" || true
    stop_pid_int "${tcpdump_pid:-}" || true
    ensure_state_dumped
    "${mlab}" case deactivate >/dev/null 2>&1 || true
    chmod -R a+rX "${run_dir}" 2>/dev/null || true
    exit "${rc}"
  }
  trap finish EXIT

  local t0 t1 t2 t3
  t0="$(date -u +%s%3N)"

  "${mlab}" case activate "${case_id}" >/dev/null
  t1="$(date -u +%s%3N)"

  # Capture WAN traffic.
  tcpdump_pid="$(start_bg_in_netns "${NS_WAN}" /dev/null tcpdump -ni br0 -w "${run_dir}/wan.pcap")"

  if [[ "${start_natpmpd}" -eq 1 ]]; then
    natpmpd_args=("${natpmpd}" "--wan-if" "wan0" "--lan-if" "lan0" "--external-ip")
    if [[ "${natpmpd_verbose}" -eq 1 ]]; then
      natpmpd_args+=("--verbose")
    fi

    natA_pmp_pid="$(start_bg_in_netns "${NS_NAT_A}" "${run_dir}/natA.natpmpd.log" "${natpmpd_args[@]}" "${WAN_A_IP}")"
    natB_pmp_pid="$(start_bg_in_netns "${NS_NAT_B}" "${run_dir}/natB.natpmpd.log" "${natpmpd_args[@]}" "${WAN_B_IP}")"
    sleep 0.2
  fi

  # Local STUN: provide 2 endpoints for discovery.
  if [[ "${disable_stun}" -eq 0 ]]; then
    stun_pid="$(start_bg_in_netns "${NS_STUN}" "${run_dir}/stun.log" "${miopunch}" stun --listen "${STUN_IP}:3478" --listen "${STUN_IP}:3479")"
    sleep 0.2
  fi

  if [[ "${signaling}" == "coord" ]]; then
    # Coordinator.
    coord_pid="$(start_bg_in_netns "${NS_COORD}" "${run_dir}/coord.log" "${miopunch}" coord --listen "${COORD_IP}:7000" --proto "${control_proto}")"

    # Wait for coordinator to become ready (avoid connection refused race).
    local t_coord_start t_coord_now
    t_coord_start="$(date +%s)"
    while true; do
      if grep -q "\"msg\":\"coordinator listening\"" "${run_dir}/coord.log" 2>/dev/null; then
        break
      fi
      if ! kill -0 "${coord_pid}" 2>/dev/null; then
        die "coordinator exited before ready (run_dir=${run_dir})"
      fi
      t_coord_now="$(date +%s)"
      if ((t_coord_now - t_coord_start >= 10)); then
        die "coordinator not ready after 10s (run_dir=${run_dir})"
      fi
      sleep 0.05
    done
  else
    mqtt_pid="$(start_bg_in_netns "${NS_COORD}" "${run_dir}/mqtt.log" "${miopunch}" mqtt-broker --listen "${mqtt_broker}")"
    sleep 0.1

    local t_mqtt_start t_mqtt_now
    t_mqtt_start="$(date +%s)"
    while true; do
      if grep -q "\"msg\":\"mqtt broker listening\"" "${run_dir}/mqtt.log" 2>/dev/null; then
        break
      fi
      if ! kill -0 "${mqtt_pid}" 2>/dev/null; then
        die "mqtt broker exited before ready (run_dir=${run_dir})"
      fi
      t_mqtt_now="$(date +%s)"
      if ((t_mqtt_now - t_mqtt_start >= 10)); then
        die "mqtt broker not ready after 10s (run_dir=${run_dir})"
      fi
      sleep 0.05
    done
  fi

  # Client peer (A) registers and waits for a single SID.
  local -a client_cmd
  client_cmd=(
    "${miopunch}" peer client
    --signaling "${signaling}"
    --proxy "${proxy_name}"
    --secret "${secret}"
    --user "a"
    --allow-users "*"
    --data-proto "${data_proto}"
    --quic-cc "${quic_cc}"
    --p2p-port "${a_p2p_port}"
  )
  if [[ -n "${attempt_v6_timeout}" ]]; then
    client_cmd+=(--attempt-v6-timeout "${attempt_v6_timeout}")
  fi
  if [[ "${disable_portmap}" -eq 1 ]]; then
    client_cmd+=(--disable-portmap)
  fi
  if [[ "${disable_stun}" -eq 0 ]]; then
    client_cmd+=(--stun "${STUN_IP}:3478,${STUN_IP}:3479")
  fi
  if [[ "${signaling}" == "coord" ]]; then
    client_cmd+=(--coord "${COORD_IP}:7000" --control-proto "${control_proto}")
  else
    client_cmd+=(--mqtt-broker "${mqtt_broker}")
  fi
  client_cmd+=(--once)

  client_pid="$(start_bg_in_netns "${NS_PEER_A}" "${run_dir}/client.log" "${client_cmd[@]}")"

  # Wait for the client to finish hello/registration, otherwise visitor precheck may race
  # (especially on QUIC control plane where handshake can take longer than a fixed sleep).
  local t_ready_start t_ready_now
  t_ready_start="$(date +%s)"
  while true; do
    if [[ "${signaling}" == "coord" ]]; then
      if grep -q "\"stage\":\"signaling\".*\"kind\":\"ok\".*\"msg\":\"connected to coordinator\"" "${run_dir}/client.log" 2>/dev/null; then
        break
      fi
    else
      if grep -q "\"stage\":\"signaling\".*\"kind\":\"ok\".*\"msg\":\"connected to mqtt broker\"" "${run_dir}/client.log" 2>/dev/null; then
        break
      fi
    fi
    if ! kill -0 "${client_pid}" 2>/dev/null; then
      die "client exited before ready (run_dir=${run_dir})"
    fi
    t_ready_now="$(date +%s)"
    if ((t_ready_now - t_ready_start >= 10)); then
      die "client not ready after 10s (run_dir=${run_dir})"
    fi
    sleep 0.05
  done

  t2="$(date -u +%s%3N)"

  # Visitor peer (B) runs once and exits with status.
  set +e
  local -a visitor_cmd
  visitor_cmd=(
    "${miopunch}" peer visitor
    --signaling "${signaling}"
    --proxy "${proxy_name}"
    --secret "${visitor_secret}"
    --user "b"
    --data-proto "${data_proto}"
    --quic-cc "${quic_cc}"
    --payload "${payload}"
    --p2p-port "${b_p2p_port}"
  )
  if [[ -n "${attempt_v6_timeout}" ]]; then
    visitor_cmd+=(--attempt-v6-timeout "${attempt_v6_timeout}")
  fi
  if [[ "${disable_portmap}" -eq 1 ]]; then
    visitor_cmd+=(--disable-portmap)
  fi
  if [[ "${disable_stun}" -eq 0 ]]; then
    visitor_cmd+=(--stun "${STUN_IP}:3478,${STUN_IP}:3479")
  fi
  if [[ "${signaling}" == "coord" ]]; then
    visitor_cmd+=(--coord "${COORD_IP}:7000" --control-proto "${control_proto}")
  else
    visitor_cmd+=(--mqtt-broker "${mqtt_broker}")
  fi

  ns_exec "${NS_PEER_B}" "${visitor_cmd[@]}" >"${run_dir}/visitor.log" 2>&1
  visitor_rc=$?
  set -e
  t3="$(date -u +%s%3N)"

  {
    echo "activate_ms=$((t1 - t0))"
    echo "start_ms=$((t2 - t1))"
    echo "visitor_ms=$((t3 - t2))"
    echo "visitor_rc=${visitor_rc}"
  } >>"${run_dir}/run.env"

  # Stop background processes (best-effort).
  stop_pid "${client_pid}" || true
  client_pid=""
  stop_pid "${coord_pid}" || true
  coord_pid=""
  stop_pid "${mqtt_pid}" || true
  mqtt_pid=""
  stop_pid "${stun_pid}" || true
  stun_pid=""
  stop_pid "${natA_pmp_pid}" || true
  natA_pmp_pid=""
  stop_pid "${natB_pmp_pid}" || true
  natB_pmp_pid=""
  stop_pid_int "${tcpdump_pid}" || true
  tcpdump_pid=""
  ensure_state_dumped

  if [[ "${expect}" == "success" ]]; then
    [[ "${visitor_rc}" -eq 0 ]] || die "expected success, got rc=${visitor_rc} (run_dir=${run_dir})"
  elif [[ "${expect}" == "fail" ]]; then
    [[ "${visitor_rc}" -ne 0 ]] || die "expected failure, got success (run_dir=${run_dir})"
  elif [[ "${expect}" == "diag-fail" ]]; then
    [[ "${visitor_rc}" -ne 0 ]] || die "expected failure (diag-fail), got success (run_dir=${run_dir})"
    grep -q "\"kind\":\"fail\"" "${run_dir}/visitor.log" || die "expected diagnostics fail event missing (run_dir=${run_dir})"
  elif [[ "${expect}" == "allow-diag-fail" ]]; then
    if [[ "${visitor_rc}" -ne 0 ]]; then
      grep -q "\"kind\":\"fail\"" "${run_dir}/visitor.log" || die "expected diagnostics fail event missing (run_dir=${run_dir})"
    fi
  fi

  if [[ -n "${expect_events_file}" ]]; then
    python3 "${assert_events}" --log "${run_dir}/visitor.log" --events "${expect_events_file}"
  fi

  if [[ -n "${expect_fail_stage}" ]]; then
    grep -E -q "\"stage\":\"${expect_fail_stage}\".*\"kind\":\"fail\"" "${run_dir}/visitor.log" \
      || die "expected fail stage '${expect_fail_stage}' not found (run_dir=${run_dir})"
  fi

  if [[ -n "${expect_path}" ]]; then
    case "${expect_path}" in
      direct_ipv6)
        grep -q "\"name\":\"attempt.v6.ok\"" "${run_dir}/visitor.log" || die "expected path '${expect_path}' not found (run_dir=${run_dir})"
        ;;
      direct_ipv4)
        grep -q "\"name\":\"attempt.v4.ok\"" "${run_dir}/visitor.log" || die "expected path '${expect_path}' not found (run_dir=${run_dir})"
        ;;
      punching_ipv4)
        grep -q "\"name\":\"attempt.punching.ok\"" "${run_dir}/visitor.log" || die "expected path '${expect_path}' not found (run_dir=${run_dir})"
        ;;
      *)
        die "unexpected expect_path: ${expect_path}"
        ;;
    esac
  fi

  if [[ "${verify_artifacts}" -eq 1 ]]; then
    verify_run_artifacts
  fi

  echo "ok: xtcp run complete: ${run_dir}"
}

main "$@"
