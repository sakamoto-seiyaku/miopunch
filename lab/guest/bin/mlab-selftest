#!/usr/bin/env bash
set -euo pipefail

if [[ "${EUID:-0}" -ne 0 ]]; then
  exec sudo -E "$0" "$@"
fi

script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
mlab="${script_dir}/mlab"

cases=("$@")
if [[ ${#cases[@]} -eq 0 ]]; then
  mapfile -t cases < <("${mlab}" case list)
fi

pass=0
fail=0

for c in "${cases[@]}"; do
  echo "== ${c} =="
  if "${mlab}" run "${c}"; then
    pass=$((pass + 1))
  else
    fail=$((fail + 1))
  fi
done

echo "summary: pass=${pass} fail=${fail}"
if [[ "${fail}" -ne 0 ]]; then
  exit 1
fi

