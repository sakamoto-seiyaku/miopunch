#!/usr/bin/env bash
set -euo pipefail

if [[ "${EUID:-0}" -ne 0 ]]; then
  exec sudo -E "$0" "$@"
fi

script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
guest_root="$(cd -- "${script_dir}/.." && pwd)"

# shellcheck source=/dev/null
source "${guest_root}/lib/poc_e2e.sh"

poc_e2e_selftest
