{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "miopunch",
  "version": "0.1.0",
  "identifier": "org.miopunch.host",
  "build": { "frontendDist": "surface" },
  "app": {
    "withGlobalTauri": true,
    "windows": [{ "label": "main", "title": "miopunch host", "create": false, "width": 640, "height": 480 }],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; connect-src ipc: http://ipc.localhost; frame-src 'none'; object-src 'none'; base-uri 'none'",
      "capabilities": ["main-host"]
    }
  },
  "bundle": { "active": false, "icon": ["icons/icon.png", "icons/icon.ico"] }
}
